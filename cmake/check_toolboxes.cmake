# THE TOOLBOX GUARD (ARCHITECTURE.md, "The toolboxes"): compute is cut into toolboxes, one folder each under compute/include/nxr/ and compute/src/, and the includes between them
# follow ONE direction. Run as a test: cmake -DROOT=<repo> -P cmake/check_toolboxes.cmake  (with -DALLOW=NONE: no ratchet file, every cross edge outside the DAG fails).
#
#   core          <- nothing                                     (types, errors, cancellation, progress, parallel, general algebra)
#   quantity, optimisation, stats, geometry  <- core
#   operators     <- core, geometry
#   selection     <- core, geometry                              (the Selection class and its resolution)
#   measurement   <- core, stats, selection
#   select        <- core, geometry, stats, selection, measurement   (the makers of selections)
#   signal        <- core, geometry, operators, stats, selection, measurement
#   synthesis     <- core, geometry, operators, stats
#   meeg (the nxr_meeg library: meeg/include, meeg/src)  <- core, optimisation   (Eigen only; never compute)
#   meeg (connectome, montage: compute/include/nxr/meeg, compute/src/meeg, still in nxr_compute)  <- core, geometry, operators
#
# Three rules, each failing the test:
#   1. every include of "nxr/<toolbox>/..." from a toolbox file is an edge of the DAG above (the ratchet below is the one exception);
#   2. no header stays at compute/include/nxr/*.h top level but the ones listed in cmake/toolboxes_allow.txt (:top lines: headers deleted by the behaviour batch), and no
#      include names "nxr/compute.h" or a former top-level header (the forwarders are gone);
#   3. the RATCHET: edges that already existed outside the DAG when the toolboxes were cut (Manifold owns its operators, the operators' synthesis helpers, ...) are listed in
#      cmake/toolboxes_allow.txt as `edge <from> <to> <count>`; the count may only fall. A new cross-toolbox include outside the DAG fails, and so does a count above the file's.
cmake_policy(SET CMP0057 NEW)
set(tbs core quantity optimisation stats geometry operators selection measurement select signal synthesis meeg)
set(dag_core "")
set(dag_quantity core)
set(dag_optimisation core)
set(dag_stats core)
set(dag_geometry core)
set(dag_operators "core;geometry")
set(dag_selection "core;geometry")
set(dag_measurement "core;stats;selection")
set(dag_select "core;geometry;stats;selection;measurement")
set(dag_signal "core;geometry;operators;stats;selection;measurement")
set(dag_synthesis "core;geometry;operators;stats")
set(dag_meeg "core;optimisation")            # the nxr_meeg library
set(dag_computemeeg "core;geometry;operators")   # connectome, montage (compute side)

# the ratchet file
set(allow_file ${ROOT}/cmake/toolboxes_allow.txt)
if(DEFINED ALLOW AND ALLOW STREQUAL "NONE")
  set(allow_file "")
endif()
set(top_allowed "")
set(ratchet_edges "")
if(allow_file AND EXISTS ${allow_file})
  file(STRINGS ${allow_file} alines)
  foreach(l IN LISTS alines)
    if(l MATCHES "^:top +([A-Za-z0-9_./]+)")
      list(APPEND top_allowed ${CMAKE_MATCH_1})
    elseif(l MATCHES "^edge +([a-z]+) +([a-z]+) +([0-9]+)")
      set(ratchet_${CMAKE_MATCH_1}_${CMAKE_MATCH_2} ${CMAKE_MATCH_3})
      list(APPEND ratchet_edges "${CMAKE_MATCH_1}_${CMAKE_MATCH_2}")
    endif()
  endforeach()
endif()

file(GLOB_RECURSE files
  ${ROOT}/compute/include/nxr/*.h ${ROOT}/compute/src/*.cpp
  ${ROOT}/meeg/include/nxr/*.h ${ROOT}/meeg/src/*.cpp)
set(bad "")
set(checked 0)
foreach(f ${files})
  if(f MATCHES "/deps/")
    continue()
  endif()
  # which toolbox is this file in
  set(from "")
  if(f MATCHES "^${ROOT}/meeg/")
    set(from meeg)
    set(rule meeg)
  elseif(f MATCHES "^${ROOT}/compute/(include/nxr|src)/meeg/")
    set(from meeg)
    set(rule computemeeg)
  elseif(f MATCHES "^${ROOT}/compute/(include/nxr|src)/([a-z]+)/")
    set(from ${CMAKE_MATCH_2})
    set(rule ${from})
    if(NOT from IN_LIST tbs)
      string(APPEND bad "  ${f}: the folder '${from}' is not a toolbox (${tbs})\n")
      continue()
    endif()
  elseif(f MATCHES "^${ROOT}/compute/include/nxr/([A-Za-z0-9_]+\\.h)$")
    # rule 2: nothing at the top level
    set(name ${CMAKE_MATCH_1})
    if(NOT name IN_LIST top_allowed)
      string(APPEND bad "  ${f}: a header at the top level of compute/include/nxr/ (put it in its toolbox; compute.h and the forwarders are gone)\n")
    endif()
    continue()
  else()
    continue()
  endif()
  math(EXPR checked "${checked} + 1")
  file(STRINGS ${f} lines REGEX "^[ \t]*#[ \t]*include[ \t]+\"nxr/")
  set(i 0)
  foreach(l IN LISTS lines)
    if(NOT l MATCHES "\"nxr/([a-zA-Z0-9_]+)(/[^\"]*)?\"")
      continue()
    endif()
    set(first ${CMAKE_MATCH_1})
    set(rest "${CMAKE_MATCH_2}")
    if(rest STREQUAL "")
      # nxr/<name>.h at the top level: a former header or compute.h
      string(APPEND bad "  ${f}: includes \"nxr/${first}\" (a top-level header: use the toolbox path)\n")
      continue()
    endif()
    if(first STREQUAL "pipelines" OR first STREQUAL "io" OR first STREQUAL "graph" OR first STREQUAL "bst")
      string(APPEND bad "  ${f}: compute and meeg include no ${first} header (${l})\n")
      continue()
    endif()
    if(NOT first IN_LIST tbs)
      continue()
    endif()
    if(first STREQUAL from)
      continue()
    endif()
    if(first IN_LIST dag_${rule})
      continue()
    endif()
    # an edge outside the DAG: counted for the ratchet
    if(DEFINED count_${from}_${first})
      math(EXPR count_${from}_${first} "${count_${from}_${first}} + 1")
    else()
      set(count_${from}_${first} 1)
      list(APPEND seen_edges "${from}_${first}")
    endif()
    if(NOT "${from}_${first}" IN_LIST ratchet_edges)
      string(APPEND bad "  ${f}: ${from} includes ${first} (${l}); the toolbox DAG has no edge ${from} -> ${first}\n")
    endif()
  endforeach()
endforeach()
if(seen_edges)
  list(REMOVE_DUPLICATES seen_edges)
endif()
foreach(e IN LISTS seen_edges)
  if(DEFINED ratchet_${e} AND count_${e} GREATER ratchet_${e})
    string(APPEND bad "  the edge ${e}: ${count_${e}} includes, the ratchet allows ${ratchet_${e}} (it may only fall)\n")
  endif()
endforeach()
# every nxr/compute.h and every former header in the other layers
file(GLOB_RECURSE users ${ROOT}/pipelines/*.cpp ${ROOT}/pipelines/*.h ${ROOT}/cli/*.cpp ${ROOT}/cli/*.h ${ROOT}/bindings/*.cpp ${ROOT}/bindings/*.h ${ROOT}/compute/test/*.cpp ${ROOT}/meeg/test/*.cpp)
foreach(f ${users})
  if(f MATCHES "/(deps|node_modules|_deps)/")
    continue()
  endif()
  file(STRINGS ${f} lines REGEX "^[ \t]*#[ \t]*include[ \t]+\"nxr/[A-Za-z0-9_]+\\.h\"")
  foreach(l IN LISTS lines)
    if(l MATCHES "\"nxr/([A-Za-z0-9_]+\\.h)\"" AND NOT CMAKE_MATCH_1 IN_LIST top_allowed AND NOT CMAKE_MATCH_1 MATCHES "^(version|nxr_neuro)\\.h$")
      if(EXISTS ${ROOT}/pipelines/include/nxr/${CMAKE_MATCH_1} OR EXISTS ${ROOT}/io/include/nxr/${CMAKE_MATCH_1})
        continue()
      endif()
      string(APPEND bad "  ${f}: includes \"nxr/${CMAKE_MATCH_1}\", a header that is no longer at the top level (use the toolbox path)\n")
    endif()
  endforeach()
endforeach()
if(NOT DEFINED MIN)
  set(MIN 50)
endif()
if(checked LESS MIN)
  message(FATAL_ERROR "toolbox guard: only ${checked} files found under ${ROOT}: is ROOT right?")
endif()
if(bad)
  message(FATAL_ERROR "toolbox guard failed:\n${bad}")
endif()
message(STATUS "toolbox guard: ${checked} files follow the toolbox DAG")
