# THE RECORDS LAYERING GUARD (docs/specs/2026-11-17-io-record-api.md, section 4): only io includes the database headers or writes SQL. Pipelines, the command line,
# the bindings, compute and meeg (tests included) ask io's record API (nxr/io/records/records.h) typed questions.
# Run as a test:  cmake -DROOT=<repo> [-DALLOW=<file>|NONE] [-DLIST=1] -P cmake/check_records_layering.cmake
#
# bindings/wasm-io is exempt: it serves the Studio and keeps level 1 (the repositories). Every other binding is checked like the pipelines.
# It fails on, in a .cpp or .h under pipelines/, cli/, bindings/, compute/, meeg/ (vendored trees skipped; comment lines skipped):
#   - an #include of nxr/io/database.h or sqlite3.h, or of nxr/io/records/ (the repositories are inside io; bindings/wasm-io is exempt), or of nxr/io/testing/ outside a test/ folder;
#   - a string literal that starts with an SQL verb (SELECT, INSERT, UPDATE x, DELETE FROM, WITH x AS, CREATE/DROP/ALTER, PRAGMA, BEGIN, ...);
#   - `.db()`, `->db()`, `Database`, `sqlite3_`.
# A line with `tamper(` (the test probe's corruption on purpose) is exempt.
# ALLOW (default cmake/records_layering_allow.txt): the files not yet migrated, one path per line relative to ROOT, '#' comments. A listed file is exempt, but a listed
# file that is clean fails ("remove it from the list"), and an unlisted file with a violation fails: the list only shrinks and no new SQL lands while the old goes.
# LIST=1 prints the violating files instead of failing (how the list was made).
cmake_minimum_required(VERSION 3.20)   # IN_LIST (policy CMP0057) in script mode
if(NOT ROOT)
  message(FATAL_ERROR "ROOT is not set")
endif()
if(NOT ALLOW)
  set(ALLOW ${ROOT}/cmake/records_layering_allow.txt)
endif()
set(allowed "")
if(NOT ALLOW STREQUAL "NONE" AND EXISTS ${ALLOW})
  file(STRINGS ${ALLOW} allow_lines)
  foreach(l IN LISTS allow_lines)
    string(STRIP "${l}" l)
    if(NOT l STREQUAL "" AND NOT l MATCHES "^#")
      list(APPEND allowed ${l})
    endif()
  endforeach()
endif()
file(GLOB_RECURSE files
  ${ROOT}/pipelines/*.cpp ${ROOT}/pipelines/*.h ${ROOT}/cli/*.cpp ${ROOT}/cli/*.h
  ${ROOT}/bindings/*.cpp ${ROOT}/bindings/*.h ${ROOT}/compute/*.cpp ${ROOT}/compute/*.h ${ROOT}/meeg/*.cpp ${ROOT}/meeg/*.h)
set(sql_start "[\"(][ \t]*(SELECT[ \t]|INSERT[ \t]|REPLACE INTO|UPDATE[ \t]+[a-z_]|DELETE FROM|WITH[ \t]+[a-z_]+[ \t]+AS|CREATE[ \t]+(TABLE|INDEX|VIEW|TRIGGER|UNIQUE)|DROP[ \t]+(TABLE|INDEX|VIEW|TRIGGER)|ALTER[ \t]+TABLE|PRAGMA[ \t]|SAVEPOINT[ \t]|RELEASE[ \t]|ATTACH[ \t]|VACUUM|BEGIN[ ;\"]|COMMIT[ ;\"]|ROLLBACK[ ;\"])")
set(violating "")
set(bad "")
set(scanned 0)
foreach(f ${files})
  if(f MATCHES "/(deps|extern|build)/")
    continue()
  endif()
  math(EXPR scanned "${scanned} + 1")
  file(RELATIVE_PATH rel ${ROOT} ${f})
  if(rel MATCHES "^bindings/wasm-io/")
    continue()   # the Studio's server-side surface: it keeps the repositories (level 1) and the database; every other binding uses the task API only
  endif()
  set(in_test OFF)
  if(rel MATCHES "(^|/)test/" OR rel MATCHES "(^|/)smoke\\.cpp$")
    set(in_test ON)
  endif()
  # one list element per line, whatever the line holds (a `;` or an unbalanced `[` would split or merge elements of a list)
  file(READ ${f} text)
  string(REPLACE ";" " " text "${text}")
  string(REPLACE "[" "(" text "${text}")
  string(REPLACE "]" ")" text "${text}")
  string(REPLACE "\n" " ;" text "${text}")
  set(lines "${text}")
  set(i 0)
  set(file_bad "")
  foreach(l IN LISTS lines)
    math(EXPR i "${i} + 1")
    if(l MATCHES "^[ \t]*(//|/\\*|\\*)" OR l MATCHES "tamper\\(")
      continue()
    endif()
    set(why "")
    if(l MATCHES "#[ \t]*include[ \t]*[<\"](nxr/io/database\\.h|sqlite3\\.h)[>\"]")
      set(why "includes a database header")
    elseif(l MATCHES "#[ \t]*include[ \t]*[<\"]nxr/io/records/" AND NOT rel MATCHES "^bindings/wasm-io/")
      set(why "includes a record repository header (level 1, inside io: use the task API)")
    elseif(l MATCHES "#[ \t]*include[ \t]*[<\"]nxr/io/testing/" AND NOT in_test)
      set(why "includes the test-only probe outside a test")
    elseif(l MATCHES "${sql_start}")
      set(why "a string literal that is SQL")
    elseif(l MATCHES "\\.db\\(\\)|->db\\(\\)|\\bDatabase\\b|sqlite3_")
      set(why "reaches the database handle")
    endif()
    if(NOT why STREQUAL "")
      string(APPEND file_bad "  ${rel}:${i}: ${why}: ${l}\n")
    endif()
  endforeach()
  if(NOT file_bad STREQUAL "")
    list(APPEND violating ${rel})
    if(NOT rel IN_LIST allowed)
      string(APPEND bad "${file_bad}")
    endif()
  endif()
endforeach()
if(LIST)
  list(SORT violating)
  foreach(v ${violating})
    message(STATUS "${v}")
  endforeach()
  list(LENGTH violating n)
  message(STATUS "${n} files")
  return()
endif()
foreach(a ${allowed})
  if(NOT a IN_LIST violating)
    string(APPEND bad "  ${a}: on the allowlist (cmake/records_layering_allow.txt) but clean: remove it from the list\n")
  endif()
endforeach()
if(bad)
  message(FATAL_ERROR "SQL or the database handle outside io (the record API is the only way to rows; docs/specs/2026-11-17-io-record-api.md):\n${bad}")
endif()
list(LENGTH allowed n_allowed)
message(STATUS "records layering: ${scanned} files scanned, ${n_allowed} on the allowlist")
