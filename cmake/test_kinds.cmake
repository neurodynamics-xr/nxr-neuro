# Every ctest test has exactly one KIND (unit, golden, integration, guard), and `slow` when it takes more than about 5 s.
# The table is tests/kinds.tsv: name<TAB>kind[<TAB>slow]. A test missing from it fails the configure, so a new test must declare its kind.
# Call nxr_test_kinds() at the END of each CMakeLists.txt that registers tests: set_tests_properties acts only on the directory that added the test.
set(NXR_TEST_KINDS_FILE ${CMAKE_CURRENT_LIST_DIR}/../tests/kinds.tsv)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${NXR_TEST_KINDS_FILE})

function(nxr_test_kinds)
  get_directory_property(_tests TESTS)
  if(NOT _tests)
    return()
  endif()
  file(STRINGS ${NXR_TEST_KINDS_FILE} _lines)
  foreach(_line IN LISTS _lines)
    if(_line MATCHES "^#" OR _line STREQUAL "")
      continue()
    endif()
    string(REPLACE "\t" ";" _f "${_line}")
    list(GET _f 0 _name)
    list(GET _f 1 _kind)
    if(NOT _kind MATCHES "^(unit|golden|integration|guard)$")
      message(FATAL_ERROR "tests/kinds.tsv: test ${_name} has kind '${_kind}'; use unit, golden, integration or guard")
    endif()
    set(_kind_of_${_name} ${_kind})
    list(LENGTH _f _n)
    if(_n GREATER 2)
      list(GET _f 2 _flag)
      if(_flag STREQUAL "slow")
        set(_slow_${_name} TRUE)
      endif()
    endif()
  endforeach()
  foreach(_t IN LISTS _tests)
    if(NOT DEFINED _kind_of_${_t})
      message(FATAL_ERROR "test '${_t}' is not in tests/kinds.tsv: add a line  ${_t}<TAB>unit|golden|integration|guard[<TAB>slow]  (see CONTRIBUTING.md, Test kinds)")
    endif()
    set_property(TEST ${_t} APPEND PROPERTY LABELS ${_kind_of_${_t}})
    if(_slow_${_t})
      get_test_property(${_t} LABELS _labels)
      if(NOT "slow" IN_LIST _labels)
        set_property(TEST ${_t} APPEND PROPERTY LABELS slow)
      endif()
    endif()
  endforeach()
endfunction()
