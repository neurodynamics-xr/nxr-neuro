# THE FORMATS LAYERING GUARD: io/formats/ holds pure readers and writers (bytes <-> plain objects). They never touch a store, a database, a
# writer, a dataset, a subject or a package, and never the Brainstorm layer, compute, meeg or pipelines.
# The one nxr/io header they may include is errors.h (the error type). Run as a test:
#   cmake -DFORMATS_DIR=<repo>/io/formats -P cmake/check_formats_layering.cmake
if(NOT FORMATS_DIR)
  message(FATAL_ERROR "FORMATS_DIR is not set")
endif()
file(GLOB_RECURSE files ${FORMATS_DIR}/*.h ${FORMATS_DIR}/*.cpp ${FORMATS_DIR}/*.hpp)
set(bad "")
foreach(f ${files})
  file(STRINGS ${f} lines)
  set(i 0)
  foreach(l IN LISTS lines)
    math(EXPR i "${i} + 1")
    if(l MATCHES "^[ \t]*#[ \t]*include[ \t]*[<\"]nxr/(io|bst|pipelines|compute|meeg)")
      if(NOT l MATCHES "[<\"]nxr/io/errors\\.h[>\"]")
        string(APPEND bad "  ${f}:${i}: a pure format includes beyond nxr/io/errors.h: ${l}\n")
      endif()
    endif()
    if(l MATCHES "^[ \t]*#[ \t]*include[ \t]*\"(\\.\\./|src/)")
      string(APPEND bad "  ${f}:${i}: a pure format reaches outside its own folder: ${l}\n")
    endif()
  endforeach()
endforeach()
if(bad)
  message(FATAL_ERROR "io/formats includes a store, database, writer or other non-format header (io/formats/CMakeLists.txt, the layering rule):\n${bad}")
endif()
list(LENGTH files n)
message(STATUS "formats layering: ${n} files include no store, database or writer header")
