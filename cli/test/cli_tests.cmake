  expect_in("nxr-origin/1" "${OUT}" "the origin record")
  expect_in("\"n_channels\": 3" "${OUT}" "the channels")
  expect_in("edf:edf_plain.edf#sha256=" "${OUT}" "the source is relative and hashed")
  string(FIND "${OUT}" "${DATA}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "an absolute path was recorded: ${OUT}")
  endif()
  # (ids are deterministic in these tests, so a second import goes to its own package)
  expect_rc(0 create package --package b.nxr.zarr --name S --home-dataset demo)
  expect_rc(0 import recording --from ${DATA}/fif_basic_raw.fif --package b.nxr.zarr --anonymize --name anon)
  expect_rc(0 verify package --package b.nxr.zarr)
  expect_rc(0 verify package --package a.nxr.zarr)
  expect_rc(1 import recording --from ${DATA}/eeglab_epoched.set --package a.nxr.zarr)
  expect_rc(1 import recording --from ${DATA}/edf_plain.edf --package nope.nxr.zarr)
  expect_rc(2 import recording --package a.nxr.zarr)
  expect_rc(1 import recording --from ${DATA}/bids/README --package a.nxr.zarr)
  # --in-place: the package links the file (its absolute path and SHA-256 are in the package, never in the printed result); verifies; a folder is refused
  file(COPY ${DATA}/edf_plain.edf DESTINATION "${WORK}/src")
  expect_rc(0 create package --package c.nxr.zarr --name S --home-dataset demo)
  expect_rc(0 import recording --from ${WORK}/src/edf_plain.edf --package c.nxr.zarr --in-place)
  expect_rc(0 verify package --package c.nxr.zarr)
  expect_rc(1 import recording --from ${DATA}/ctf/ctf_cont.ds --package c.nxr.zarr --in-place)
  # `import fif` / `import transform`: an MNE object file into a package (a source space and a head-to-MRI transform need no recording); refusals
  expect_rc(0 create package --package f.nxr.zarr --name S --home-dataset demo)
  expect_rc(0 import fif --from ${DATA}/fif_obj_surf-src.fif --package f.nxr.zarr --name ss)
  expect_in("\"kind\": \"src\"" "${OUT}" "the kind is found from the file")
  expect_rc(0 import transform --from ${DATA}/fif_obj-trans.fif --package f.nxr.zarr --name h)
  expect_rc(0 verify package --package f.nxr.zarr)
  expect_rc(1 import fif --from ${DATA}/fif_obj-eve.fif --package f.nxr.zarr)
  expect_rc(1 import fif --from ${DATA}/edf_plain.edf --package f.nxr.zarr)
  expect_rc(2 import fif --package f.nxr.zarr)
  # `import nifti`: a volume in its voxel chart with its transition; a series of volumes and an unnamed label volume are refused
  expect_rc(0 create package --package n.nxr.zarr --name S --home-dataset demo)
  expect_rc(0 import nifti --from ${DATA}/nifti_f32_sform.nii --package n.nxr.zarr --name t1)
  expect_in("\"transition\": \"t1_volume_nifti-aligned\"" "${OUT}" "the transition to the file's world system")
  expect_rc(0 verify package --package n.nxr.zarr)
  expect_rc(1 import nifti --from ${DATA}/nifti_u8_4d.nii.gz --package n.nxr.zarr)
  expect_rc(1 import nifti --from ${DATA}/nifti_f32_sform.nii --package n.nxr.zarr --name lab --kind labels)
  expect_rc(2 import nifti --package n.nxr.zarr)
  # `import bids`: the synthetic BIDS tree into a dataset of packages; the participant variables make --where work; refusals
  expect_rc(0 import bids --from ${DATA}/bids --dataset bids-ds)
  expect_in("sub-01" "${OUT}" "the subjects")
  expect_in("\"age\"" "${OUT}" "the participant variables")
  expect_rc(0 verify package --package bids-ds/sub-02.nxr.zarr)
  expect_rc(1 import bids --from ${DATA}/bids --dataset bids-ds)
  expect_rc(1 import bids --from ${DATA}/bids --dataset bids-none --subject nobody)
  expect_rc(1 import bids --from ${WORK}/no-such-folder --dataset bids-x)
  expect_rc(2 import bids --dataset bids-x)
  # `create recording --synthetic`: sine waves plus noise from a seed, stored as an imported recording is
  expect_rc(0 create package --package d.nxr.zarr --name S --home-dataset demo)
  expect_rc(0 create recording --synthetic --package d.nxr.zarr --name syn --channels 4 --sfreq 100 --duration 5 --seed 3)
  expect_in("\"n_channels\": 4" "${OUT}" "the synthetic channels")
  expect_in("\"n_samples\": 500" "${OUT}" "the synthetic samples")
  expect_rc(0 verify package --package d.nxr.zarr)
  expect_rc(0 create recording --help)
  expect_in("--synthetic" "${OUT}" "create recording help")
  expect_rc(2 create recording --package d.nxr.zarr)
  expect_rc(2 create recording --synthetic --package d.nxr.zarr --channels abc)
  expect_rc(1 create recording --synthetic --package d.nxr.zarr --name syn2 --sfreq 100 --frequency 80)

else()
  message(FATAL_ERROR "unknown CASE '${CASE}'")
endif()
