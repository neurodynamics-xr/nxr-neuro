# nxr-neuro's command line, tested through the built executable: cmake -DCLI=<nxr-neuro> -DWORK=<scratch dir> -DCASE=<name> -P cli_tests.cmake
# Cases: table (the help tables match the parsers) · help (--help renders for every verb and command) · verbs (each verb group parses and dispatches)
#        aliases (every old spelling still works and says so) · range (a time range is required) · output (readable and JSON forms, quiet, colour)
#        json (the JSON lines of a few commands are byte for byte today's) · generated (man pages and completion)
cmake_minimum_required(VERSION 3.20)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# run the command in WORK with deterministic ids; sets OUT, ERR, RC in the caller
function(nxr)
  execute_process(COMMAND ${CMAKE_COMMAND} -E env NXR_IO_DETERMINISTIC=1 -- ${CLI} ${ARGN} WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(RC "${rc}" PARENT_SCOPE)
  set(OUT "${out}" PARENT_SCOPE)
  set(ERR "${err}" PARENT_SCOPE)
endfunction()
function(expect_rc want)
  nxr(${ARGN})
  if(NOT RC EQUAL want)
    message(FATAL_ERROR "nxr-neuro ${ARGN}: exit ${RC}, wanted ${want}\nstdout: ${OUT}\nstderr: ${ERR}")
  endif()
  set(OUT "${OUT}" PARENT_SCOPE)
  set(ERR "${ERR}" PARENT_SCOPE)
endfunction()
function(expect_in text haystack what)
  string(FIND "${haystack}" "${text}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "${what}: expected to find '${text}' in:\n${haystack}")
  endif()
endfunction()

# the commands: new words | old words | span | seconds
nxr(__commands)
string(REGEX REPLACE "\n$" "" listing "${OUT}")
string(REPLACE "\n" ";" LINES "${listing}")
if(CASE STREQUAL "table")
  expect_rc(0 __check-options)
  expect_in("matches the parsers" "${OUT}" "table check")

elseif(CASE STREQUAL "helptext")
  # every option of every command has a description of its own, printed with its default and unit
  expect_rc(0 __check-help)
  expect_in("every option has its own description" "${OUT}" "help text check")
  expect_rc(0 compute psd --help)
  expect_in("default: 0.5" "${OUT}" "psd --overlap default")
  expect_in("unit: fraction" "${OUT}" "psd --overlap unit")
  expect_rc(0 compute notch --help)
  expect_in("--bandwidth" "${OUT}" "notch --bandwidth")
  expect_rc(0 compute null --help)
  expect_in("--exceedances" "${OUT}" "null --exceedances")
  expect_in("--from" "${OUT}" "null takes a seconds range")

elseif(CASE STREQUAL "help")
  expect_rc(0 --help)
  expect_in("compute" "${OUT}" "root help")
  set(verbs "")
  foreach(line ${LINES})
    string(REGEX MATCH "^[^|]*" path "${line}")
    string(REPLACE " " ";" words "${path}")
    list(GET words 0 v)
    list(APPEND verbs ${v})
    expect_rc(0 ${words} --help)
    expect_in("Usage: nxr-neuro ${path}" "${OUT}" "help of ${path}")
    expect_in("--json" "${OUT}" "help of ${path}")
    expect_in("Example:" "${OUT}" "help of ${path}")
  endforeach()
  list(REMOVE_DUPLICATES verbs)
  foreach(v ${verbs})
    expect_rc(0 ${v} --help)
  endforeach()
  expect_rc(0 compute --help)
  foreach(topic "Source imaging" "Geometry" "Time" "Spectra" "Cortical flow and patterns" "Measurements" "Nulls")
    expect_in("${topic}:" "${OUT}" "compute --help topics")
  endforeach()

elseif(CASE STREQUAL "aliases")
  # every old spelling reaches its command (its --help is the new command's help), and a real run prints the notice
  foreach(line ${LINES})
    string(REGEX MATCH "^[^|]*" path "${line}")
    string(REGEX REPLACE "^[^|]*\\|([^|]*)\\|.*$" "\\1" old "${line}")
    if(old STREQUAL "" OR old STREQUAL line)
      continue()
    endif()
    string(REPLACE " " ";" oldwords "${old}")
    expect_rc(0 ${oldwords} --help)
    expect_in("Usage: nxr-neuro ${path}" "${OUT}" "old spelling '${old}'")
  endforeach()
  # a real run: the notice on stderr, the JSON on stdout, the same as the new spelling
  file(MAKE_DIRECTORY "${WORK}/store")
  expect_rc(0 dataset create --datastore store --name d1)
  expect_in("old spelling" "${ERR}" "dataset create notice")
  expect_in("create dataset" "${ERR}" "dataset create notice")
  expect_rc(0 subject create --dataset store/d1 --name s1)
  expect_rc(0 subject list --dataset store/d1)
  set(old_json "${OUT}")
  expect_rc(0 list subjects --dataset store/d1)
  if(NOT OUT STREQUAL old_json)
    message(FATAL_ERROR "old and new spelling differ:\n${old_json}\n${OUT}")
  endif()
  expect_rc(0 run --list)
  expect_in("old spelling" "${ERR}" "run --list notice")
  expect_in("pipelines" "${OUT}" "run --list")

elseif(CASE STREQUAL "verbs")
  file(MAKE_DIRECTORY "${WORK}/store")
  expect_rc(0 create dataset --datastore store --name d1 --json)
  expect_in("\"stage\": \"result\"" "${OUT}" "create dataset")
  expect_rc(0 list datasets --datastore store)
  expect_in("\"name\": \"d1\"" "${OUT}" "list datasets")
  expect_rc(0 show dataset --dataset store/d1)
  expect_in("\"subjects\": 0" "${OUT}" "show dataset")
  expect_rc(0 create subject --dataset store/d1 --name s1)
  expect_rc(0 show subject --dataset store/d1 --subject s1)
  expect_in("\"fields\": 0" "${OUT}" "show subject")
  expect_rc(0 list recordings --dataset store/d1 --subject s1)
  expect_in("\"recordings\": []" "${OUT}" "list recordings")
  expect_rc(0 list kernels --dataset store/d1 --subject s1)
  expect_in("\"kernels\": []" "${OUT}" "list kernels")
  expect_rc(0 list results --dataset store/d1 --subject s1)
  expect_in("\"results\": []" "${OUT}" "list results")
  expect_rc(0 compact dataset --dataset store/d1 --dry-run)
  expect_rc(0 recover dataset --dataset store/d1)
  expect_rc(0 read dataset store/d1)
  expect_in("s1" "${OUT}" "read dataset")
  expect_rc(0 list pipelines)
  expect_rc(0 delete subject --dataset store/d1 --subject s1)
  expect_rc(0 delete dataset --datastore store --name d1)
  # a computation reaches its parser: a missing recording is a data error (exit 1), not a usage error
  expect_rc(0 create dataset --datastore store --name d2)
  expect_rc(0 create subject --dataset store/d2 --name s1)
  expect_rc(1 compute psd --dataset store/d2 --subject s1 --recording nope --all)
  expect_in("no recording named" "${OUT}" "compute psd refuses a missing recording")
  # an unknown option or verb is a usage error
  expect_rc(2 compute psd --no-such-option)
  expect_rc(2 frobnicate)

elseif(CASE STREQUAL "range")
  file(MAKE_DIRECTORY "${WORK}/store")
  expect_rc(0 create dataset --datastore store --name d1)
  expect_rc(0 create subject --dataset store/d1 --name s1)
  set(checked 0)
  foreach(line ${LINES})
    string(REGEX MATCH "^[^|]*" path "${line}")
    if(NOT line MATCHES "\\|span\\|")
      continue()
    endif()
    string(REPLACE " " ";" words "${path}")
    # the required options of the command are not given on purpose: CLI11 reports them first, so give the time-range check its turn with --all/--from partial forms
    execute_process(COMMAND ${CLI} ${words} --help OUTPUT_VARIABLE help)
    expect_in("--all" "${help}" "${path} offers --all")
    if(line MATCHES "\\|seconds$")
      expect_in("--from" "${help}" "${path} offers --from")
      expect_in("--to" "${help}" "${path} offers --to")
    endif()
    string(FIND "${help}" "--chunks" at)
    if(NOT at EQUAL -1)
      message(FATAL_ERROR "${path}: --chunks must be hidden from help")
    endif()
    math(EXPR checked "${checked}+1")
  endforeach()
  if(checked LESS 15)
    message(FATAL_ERROR "only ${checked} computations declare a time range")
  endif()
  # the refusal itself, on commands whose other required options are given
  expect_rc(2 compute psd --dataset store/d1 --subject s1 --recording r)
  expect_in("a time range is required" "${ERR}" "psd without a range")
  expect_in("--from" "${ERR}" "psd without a range")
  expect_in("--all" "${ERR}" "psd without a range")
  expect_rc(2 compute noisecov --dataset store/d1 --subject s1 --recording r)
  expect_in("a time range is required" "${ERR}" "noisecov without a range")
  expect_rc(2 compute psd --dataset store/d1 --subject s1 --recording r --from 0:10)
  expect_in("--from and --to go together" "${ERR}" "from without to")
  expect_rc(2 compute psd --dataset store/d1 --subject s1 --recording r --from 0:10 --to 0:20 --all)
  expect_in("give one time range" "${ERR}" "from/to with all")
  expect_rc(2 compute psd --dataset store/d1 --subject s1 --recording r --from abc --to 5)
  expect_in("is not a time" "${ERR}" "bad time")
  expect_rc(2 compute null --dataset store/d1 --subject s1 --recording-a r)
  expect_in("a time range is required" "${ERR}" "null without a range")
  expect_in("--all" "${ERR}" "null without a range")
  expect_rc(2 compute spatialnull --dataset store/d1 --subject s1 --recording r)
  expect_in("a time range is required" "${ERR}" "spatialnull without a range")
  # a range given: the command goes on to the data (this recording does not exist)
  expect_rc(1 compute psd --dataset store/d1 --subject s1 --recording r --from 0:10 --to 1:10)
  expect_rc(1 compute psd --dataset store/d1 --subject s1 --recording r --all)
  # the old spelling without a range reaches the library, which refuses it too
  expect_rc(1 psd compute --dataset store/d1 --subject s1 --recording r)

elseif(CASE STREQUAL "output")
  file(MAKE_DIRECTORY "${WORK}/store")
  expect_rc(0 create dataset --datastore store --name d1)
  # stdout is not a terminal here: JSON lines
  expect_rc(0 list datasets --datastore store)
  string(SUBSTRING "${OUT}" 0 1 first)
  if(NOT first STREQUAL "{")
    message(FATAL_ERROR "a pipe gets JSON lines, got: ${OUT}")
  endif()
  # the readable form
  expect_rc(0 list datasets --datastore store --human)
  expect_in("list datasets: done" "${OUT}" "readable result line")
  expect_in("d1" "${OUT}" "readable table")
  string(FIND "${OUT}" "\"stage\"" at)
  if(NOT at GREATER -1)
  else()
    message(FATAL_ERROR "the readable form printed JSON: ${OUT}")
  endif()
  # --json wins over --human
  expect_rc(0 list datasets --datastore store --human --json)
  string(SUBSTRING "${OUT}" 0 1 first)
  if(NOT first STREQUAL "{")
    message(FATAL_ERROR "--json must print JSON")
  endif()
  # --quiet: only the result line
  expect_rc(0 list datasets --datastore store --human --quiet)
  string(REGEX REPLACE "\n$" "" one "${OUT}")
  string(REPLACE "\n" ";" many "${one}")
  list(LENGTH many n)
  if(NOT n EQUAL 1)
    message(FATAL_ERROR "--quiet printed ${n} lines: ${OUT}")
  endif()
  # no colour codes (not a terminal; NO_COLOR as well)
  string(ASCII 27 esc)
  string(FIND "${OUT}" "${esc}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "colour in a pipe")
  endif()
  # errors: readable on stderr, or a JSON object with its code under --json
  expect_rc(1 show dataset --dataset store/missing --human)
  expect_in("nxr-neuro: error:" "${ERR}" "readable error")
  expect_rc(1 show dataset --dataset store/missing --json)
  expect_in("\"stage\": \"error\"" "${OUT}" "json error")
  expect_in("\"code\":" "${OUT}" "json error code")
  # the old way: a failure without --json is the line it always was (no code)
  expect_rc(1 show dataset --dataset store/missing)
  expect_in("\"stage\": \"error\"" "${OUT}" "legacy error")
  string(FIND "${OUT}" "\"code\"" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "the legacy error line must not change: ${OUT}")
  endif()
  # the alias notice goes to stderr, never stdout
  expect_rc(0 dataset list --datastore store)
  string(FIND "${OUT}" "note:" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "the notice must be on stderr")
  endif()

elseif(CASE STREQUAL "json")
  # today's JSON lines, byte for byte (ids deterministic, paths relative)
  file(MAKE_DIRECTORY "${WORK}/store")
  expect_rc(0 create dataset --datastore store --name d1)
  expect_rc(0 create subject --dataset store/d1 --name s1)
  set(want "{\"stage\": \"result\", \"subject\": \"s1\", \"kind\": \"subject\", \"id\": \"00000000-0000-7000-8000-000000000002\", \"path\": \"s1.nxr.zarr\"}\n")
  expect_rc(0 list datasets --datastore store)
  set(want "{\"stage\": \"result\", \"datastore\": \"00000000-0000-7000-8000-000000000002\", \"datasets\": [{\"id\": \"00000000-0000-7000-8000-000000000003\", \"name\": \"d1\", \"path\": \"d1\", \"database\": \"d1/dataset.sqlite\", \"subjects\": 1, \"modified_utc\": \"2026-01-01T00:00:00.000Z\"}]}\n")
  if(NOT OUT STREQUAL want)
    message(FATAL_ERROR "list datasets changed:\n${OUT}\nwanted:\n${want}")
  endif()
  expect_rc(0 list subjects --dataset store/d1)
  set(want "{\"stage\": \"result\", \"dataset\": \"d1\", \"subjects\": [{\"name\": \"s1\", \"kind\": \"subject\", \"status\": \"complete\", \"path\": \"s1.nxr.zarr\"}]}\n")
  if(NOT OUT STREQUAL want)
    message(FATAL_ERROR "list subjects changed:\n${OUT}\nwanted:\n${want}")
  endif()
  expect_rc(0 show subject --dataset store/d1 --subject s1)
  set(want "{\"stage\": \"result\", \"subject\": \"s1\", \"kind\": \"subject\", \"path\": \"s1.nxr.zarr\", \"manifolds\": 0, \"fields\": 0, \"operators\": 0, \"selections\": 0}\n")
  if(NOT OUT STREQUAL want)
    message(FATAL_ERROR "show subject changed:\n${OUT}\nwanted:\n${want}")
  endif()
  expect_rc(1 show subject --dataset store/d1 --subject nope)
  expect_in("{\"stage\": \"error\", \"message\": \"" "${OUT}" "legacy error line")

elseif(CASE STREQUAL "packages")
  # the commands over subject packages and a catalogue (no deterministic ids needed: nothing here compares ids)
  expect_rc(0 create catalogue --dataset cohort --name cohort)
  expect_rc(0 create package --package cohort/S1.nxr.zarr --name S1 --home-dataset cohort)
  # (the helper above starts every process's deterministic ids at 1: a second package made so would clash with the first, which registering refuses, naming both)
  execute_process(COMMAND ${CMAKE_COMMAND} -E env NXR_IO_DETERMINISTIC=5000 -- ${CLI} create package --package cohort/S2.nxr.zarr --name S2 --home-dataset cohort
                  WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE rc2)
  if(NOT rc2 EQUAL 0)
    message(FATAL_ERROR "create package S2 failed")
  endif()
  expect_rc(0 verify package --package cohort/S1.nxr.zarr)
  expect_in("\"ok\": true" "${OUT}" "verify package")
  expect_rc(0 register package --dataset cohort --scan --registered-by test)
  expect_in("\"outcome\": \"registered\"" "${OUT}" "register package")
  expect_rc(0 register package --dataset cohort --scan --registered-by test)
  expect_in("\"outcome\": \"unchanged\"" "${OUT}" "register again")
  expect_rc(0 list subjects --dataset cohort)
  expect_in("\"name\": \"S2\"" "${OUT}" "list subjects")
  expect_rc(0 list subjects --dataset cohort --subjects S1)
  expect_in("\"how\": \"subjects\"" "${OUT}" "list subjects --subjects")
  # a filter needs participants; they are imported from BIDS files
  file(WRITE "${WORK}/participants.tsv" "participant_id\tage\tgroup\nS1\t70\tcontrol\nS2\t30\tpatient\n")
  expect_rc(1 list subjects --dataset cohort --where "age > 60")
  expect_rc(0 import participants --dataset cohort --tsv "${WORK}/participants.tsv")
  expect_rc(0 list subjects --dataset cohort --where "group == 'control' and age >= 60")
  expect_in("\"name\": \"S1\"" "${OUT}" "list subjects --where")
  expect_rc(1 list subjects --dataset cohort --where "agee > 1")
  expect_in("the participants table has: age, group" "${OUT}" "unknown variable named")
  expect_rc(0 list subjects --dataset cohort --subjects S1,S2)
elseif(CASE STREQUAL "generated")
  expect_rc(0 __man "${WORK}/man")
  file(GLOB pages "${WORK}/man/*.1")
  list(LENGTH pages n)
  list(LENGTH LINES commands)
  if(n LESS ${commands})
    message(FATAL_ERROR "${n} man pages for ${commands} commands")
  endif()
  file(READ "${WORK}/man/nxr-neuro-compute-psd.1" page)
  expect_in(".SH OPTIONS" "${page}" "man page")
  expect_in("EXAMPLES" "${page}" "man page")
  foreach(shell bash zsh fish)
    expect_rc(0 completion ${shell})
    expect_in("compute" "${OUT}" "${shell} completion")
    expect_in("--recording" "${OUT}" "${shell} completion")
  endforeach()
  expect_rc(2 completion tcsh)

else()
  message(FATAL_ERROR "unknown CASE '${CASE}'")
endif()
