elseif(CASE STREQUAL "pipelines")
  # every pipeline is run with `run`: the hand-wired ones and the definitions; names are in one table only and no name has a dot
  expect_rc(0 __check-pipelines)
  expect_in("every pipeline has its own name" "${OUT}" "pipeline names and parameters")
  # every old spelling of a pipeline is refused, naming the new one (no alias runs)
  expect_rc(0 __refused)
  string(REGEX REPLACE "\n$" "" refused_list "${OUT}")
  string(REPLACE "\n" ";" REFUSED "${refused_list}")
  list(LENGTH REFUSED n_refused)
  if(n_refused LESS 30)
    message(FATAL_ERROR "only ${n_refused} refused spellings")
  endif()
  foreach(line ${REFUSED})
    string(REGEX REPLACE "\\|.*$" "" old "${line}")
    string(REGEX REPLACE "^[^|]*\\|" "" new "${line}")
