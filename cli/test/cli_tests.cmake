  expect_rc(0 create dataset --dataset cohort --name cohort)
  expect_in("\"form\": \"catalogue\"" "${OUT}" "create dataset makes a catalogue")
  expect_rc(0 show dataset --dataset cohort)
  expect_in("\"form\": \"catalogue\"" "${OUT}" "show dataset")
