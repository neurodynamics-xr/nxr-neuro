# BYTE IDENTITY of the stored dataset (the store work: no format change). Writes the conformance scenario (a dataset, a subject, a surface, plain,
# dense and sharded fields, a selection, an operator), leaves an interrupted node and removes a node, then compares EVERY folder and file hash of the tree
# with the golden made by the code before the store interface (golden/store_identity.txt). The database file is left out (its bytes carry the clock).
# Format 51 (2026-11-14) writes the chunk key separator "." (golden/store_identity.txt). With -DLAYOUT=slash the written tree is first turned into the
# layout of format 50 (c.0.1 -> c/0/1, "separator":"/" in every zarr.json) and compared with golden/store_identity_v50.txt, the golden made before the
# change: the old layout stays what a reader must read, byte for byte.
# Run as a test: cmake -DSCENARIO=<nxr-neuro-scenario> -DOBJ=<mesh.obj> -DGOLDEN=<golden file> -DWORK=<scratch folder> -P store_identity.cmake
file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK})
foreach(step "scenario;${WORK}/ds;${OBJ}" "interrupt;${WORK}/ds/demo;S1" "remove;${WORK}/ds/demo;S1;field;source/small")
  execute_process(COMMAND ${SCENARIO} ${step} RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "nxr-neuro-scenario ${step} failed (${rc})")
  endif()
endforeach()
if("${LAYOUT}" STREQUAL "slash")
  file(GLOB_RECURSE all RELATIVE ${WORK} ${WORK}/*)
  foreach(f ${all})
    if(f MATCHES "^(.*/)c((\\.[0-9]+)+)$")
      string(REPLACE "." "/" tail "${CMAKE_MATCH_2}")
      get_filename_component(dir "${WORK}/${CMAKE_MATCH_1}c${tail}" DIRECTORY)
      file(MAKE_DIRECTORY ${dir})
      file(RENAME ${WORK}/${f} ${WORK}/${CMAKE_MATCH_1}c${tail})
    elseif(f MATCHES "zarr\\.json$")
      file(READ ${WORK}/${f} txt)
      string(REPLACE "\"separator\":\".\"" "\"separator\":\"/\"" txt "${txt}")
      file(WRITE ${WORK}/${f} "${txt}")
    endif()
  endforeach()
endif()
if(COMPACT)
  # `dataset compact` turns the format-50 tree into the format-51 one: the same golden (the tree after it is the one the writer makes now)
  execute_process(COMMAND ${SCENARIO} compact ${WORK}/ds/demo RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "nxr-neuro-scenario compact failed (${rc}): ${err}")
  endif()
endif()
file(GLOB_RECURSE found LIST_DIRECTORIES true RELATIVE ${WORK} ${WORK}/*)
set(have "")
foreach(f ${found})
  if(f MATCHES "dataset\\.sqlite")
    continue()
  endif()
  if(IS_DIRECTORY ${WORK}/${f})
    list(APPEND have "d ./${f}")
  else()
    file(SHA256 ${WORK}/${f} h)
    list(APPEND have "${h}  ./${f}")
  endif()
endforeach()
list(APPEND have "d .")
file(STRINGS ${GOLDEN} want)
list(SORT have)
list(SORT want)
if(NOT have STREQUAL want)
  set(missing "")
  set(extra "")
  foreach(l ${want})
    if(NOT l IN_LIST have)
      string(APPEND missing "  ${l}\n")
    endif()
  endforeach()
  foreach(l ${have})
    if(NOT l IN_LIST want)
      string(APPEND extra "  ${l}\n")
    endif()
  endforeach()
  message(FATAL_ERROR "the stored tree differs from the golden.\nmissing or changed:\n${missing}extra or changed:\n${extra}")
endif()
file(REMOVE_RECURSE ${WORK})
message(STATUS "store identity: every folder and file of the scenario is as the golden")
