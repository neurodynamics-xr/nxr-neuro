# The formats layering check must fail on a bad include and pass on a good tree (run as a test: -DCHECK=<script> -DWORK=<scratch folder>).
file(REMOVE_RECURSE ${WORK})
file(MAKE_DIRECTORY ${WORK}/good ${WORK}/bad_store ${WORK}/bad_db ${WORK}/bad_writer)
file(WRITE ${WORK}/good/a.h "#include \"nxr/io/errors.h\"\n#include \"nxr/formats/recording.h\"\n#include <vector>\n")
file(WRITE ${WORK}/bad_store/a.h "#include \"nxr/io/store.h\"\n")
file(WRITE ${WORK}/bad_db/a.cpp "  #include <nxr/io/database.h>\n")
file(WRITE ${WORK}/bad_writer/a.cpp "#include \"nxr/io/writer.h\"\n")
execute_process(COMMAND ${CMAKE_COMMAND} -DFORMATS_DIR=${WORK}/good -P ${CHECK} RESULT_VARIABLE r OUTPUT_QUIET ERROR_QUIET)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "the check rejected a good tree")
endif()
foreach(d bad_store bad_db bad_writer)
  execute_process(COMMAND ${CMAKE_COMMAND} -DFORMATS_DIR=${WORK}/${d} -P ${CHECK} RESULT_VARIABLE r OUTPUT_QUIET ERROR_QUIET)
  if(r EQUAL 0)
    message(FATAL_ERROR "the check passed ${d}")
  endif()
endforeach()
